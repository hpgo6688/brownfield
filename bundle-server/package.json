{
  "name": "bundle-server",
  "version": "2.0.0",
  "private": true,
  "description": "Dynamic multi-bundle manifest server with admin UI and rollback",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -R src/admin dist/admin",
    "start": "node dist/index.js",
    "dev": "npm run db:prepare && tsx watch src/index.ts",
    "db:prepare": "prisma db push && tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "@prisma/client": "^6.5.0",
    "fastify": "^5.2.1",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/semver": "^7.5.8",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
